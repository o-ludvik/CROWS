{"inkVersion":21,"root":[["end",["done",{"#n":"g-0"}],null],"done",{"day1":[["^Ota Hrubý. Vozka. Teda… byl jsem vozka, dokud jsem měl vůz. ","#","^reveal:name ","/#","#","^stress:+1","/#","\n","^Včera v noci spadl most přes Vranku. I s mým druhým vozem a s Matějem na kozlíku. ","#","^quest:bridge","/#","\n","ev","str","^To je mi líto. Co vám naleju?","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Slyšel jsem. Celé sedlo o tom mluví.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Pálenku. A nic neříkejte, dokud ji nevypiju. ","#","^aff:self:+1","/#","\n",{"->":".^.^.g-0"},{"#f":5}],"c-1":["\n","^Mluví. Mluvit umí každý. Tahat Matěje z řeky nikdo. ","#","^aff:self:-1 ","/#","#","^stress:+1","/#","\n",{"->":".^.^.g-0"},{"#f":5}],"g-0":["^Vezl jsem stříbro do Kamence. Výplatu pro horníky. Teď ho má Vranka. ","#","^reveal:faction","/#","\n","^Lukovinští brali mostné deset let a lana nevyměnili ani jednou. ","#","^cut:bridge_cause:k3_rot ","/#","#","^quest:bridge","/#","\n","^Tak mi řekněte, hostinský – vy čtete noviny. Kdo za to může?","\n","ev","str","^Velesští. Lukovinský posel píše o vorařích se sekerami. ","#","^slot:bridge_cause:k1_axe","/#","/str","/ev",{"*":".^.c-2","flg":20},"ev","str","^Lukovina. Lana byla shnilá. ","#","^slot:bridge_cause:k3_rot","/#","/str","/ev",{"*":".^.c-3","flg":20},"ev","str","^Váš lom. Ten den tam prý střílel prach. ","#","^slot:bridge_cause:k2_blasting","/#","/str","/ev",{"*":".^.c-4","flg":20},"ev","str","^Ještě je brzo soudit.","/str","/ev",{"*":".^.c-5","flg":20},"ev","str","^Nevím. Ale zjistím to.","/str","/ev",{"*":".^.c-6","flg":20},{"c-2":["\n","^Velesští! Ti by podřízli i vlastní matku, kdyby z ní byl vor. ","#","^aff:self:+2 ","/#","#","^aff:k1:-2 ","/#","#","^aff:k2:+1 ","/#","#","^stress:+1","/#","\n","ev","str","^k1","/str","/ev",{"VAR=":"blames","re":true},{"->":"day1.0.g-1"},{"#f":5}],"c-3":["\n","^Přesně tak. Deset let mýta a ani jeden nový provaz. ","#","^aff:self:+2 ","/#","#","^aff:k3:-2 ","/#","#","^aff:k2:+1","/#","\n","ev","str","^k3","/str","/ev",{"VAR=":"blames","re":true},{"->":"day1.0.g-1"},{"#f":5}],"c-4":["\n","^Cože? Já ten prach vozím, hostinský! Ten den se v lomu nestřílelo. ","#","^aff:self:-3 ","/#","#","^aff:k2:-1 ","/#","#","^stress:+3","/#","\n","ev","str","^k2","/str","/ev",{"VAR=":"blames","re":true},{"->":"day1.0.g-1"},{"#f":5}],"c-5":["\n","^Brzo? Matěj leží v řece a vy mi říkáte brzo. ","#","^aff:self:-1 ","/#","#","^stress:+2","/#","\n",{"->":"day1.0.g-1"},{"#f":5}],"c-6":["\n","^Tak to zjistěte rychle. Než to zjistí vojáci. ","#","^aff:self:+1 ","/#","#","^stress:+1","/#","\n",{"->":"day1.0.g-1"},{"#f":5}]}],"g-1":["^Dneska tu prý máte jen jeden stůl.","\n","^Jestli si ke mně přisedne někdo z Velesie, nevím, jestli udržím ruce na stole. ","#","^cut","/#","\n","ev","str","^Tady se nikdo nepere. Ani dneska.","/str","/ev",{"*":".^.c-7","flg":20},"ev","str","^Kdyby bylo zle, přijďte si sednout k pultu.","/str",{"VAR?":"aff_self"},1,">=","/ev",{"*":".^.c-8","flg":21},"ev","str","^Hlavně mi tu nic nerozbijte. Mám dost starostí.","/str",{"VAR?":"stress"},4,">=","/ev",{"*":".^.c-9","flg":21},{"c-7":["\n","^Uvidíme. ","#","^aff:self:-1 ","/#","#","^stress:+1","/#","\n",{"->":"day1.0.g-2"},{"#f":5}],"c-8":["\n","^…Díky. To je od vás slušné. ","#","^aff:self:+2 ","/#","#","^stress:-1","/#","\n","ev",true,"/ev",{"VAR=":"promised_calm","re":true},{"->":"day1.0.g-2"},{"#f":5}],"c-9":["\n","^Vy máte starosti? ","#","^aff:self:-2 ","/#","#","^stress:+2","/#","\n",{"->":"day1.0.g-2"},{"#f":5}]}],"g-2":["end",null]}],null],"followup_day2":[["^Jdu dolů do rokle. Musím najít vůz – a Matěje, jestli ho řeka vrátila. ","#","^quest:bridge","/#","\n","^V noci jsem slyšel vaše vrány. Kdo posílá dopisy o půlnoci, hostinský? ","#","^cut ","/#","#","^quest:crows","/#","\n","ev","str","^Nikdo. Vrány v noci nelétají.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Vezměte si ode mě lano a lucernu.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Tyhle létaly. Slyšel jsem