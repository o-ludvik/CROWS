{"inkVersion":21,"root":[["^Bohdan, kupec. Vezu sůl přes hory. ","#","^reveal:name","/#","\n","^Áčko nás obviňuje z požáru. Je to výmysl. ","#","^cut","/#","\n","ev","str","^Mají svědky.","/str","/ev",{"*":"0.c-0","flg":20},"ev","str","^Vaši vojáci prý nebyli u hranice.","/str","/ev",{"*":"0.c-1","flg":20},"ev","str","^Pašeráci z Céčka?","/str","/ev",{"*":"0.c-2","flg":20},{"c-0":["\n","^Svědky si koupíte za pár grošů. ","#","^aff:self:-1","/#","\n",{"->":"0.g-0"},{"#f":5}],"c-1":["\n","^Přesně tak! Četl jste Posla. ","#","^aff:self:+2 ","/#","#","^aff:k2:+1","/#","\n",{"->":"0.g-0"},{"#f":5}],"c-2":["\n","^To je možné. Céčko své lidi nehlídá. ","#","^aff:k3:-1","/#","\n",{"->":"0.g-0"},{"#f":5}],"g-0":["^Jsem z Království B, pyšně to říkám. ","#","^reveal:faction","/#","\n","ev","str","^Tady se o politice nemluví.","/str","/ev",{"*":".^.c-3","flg":20},"ev","str","^Mluvte, poslouchám.","/str","/ev",{"*":".^.c-4","flg":20},{"c-3":["\n","^Dobrá, dobrá. Ale ta Mira z Áčka, co tu chodí, je štvavá. ","#","^aff:mira:-1","/#","\n",{"->":"0.g-1"},{"#f":5}],"c-4":["\n","^Mír visí na vlásku, hostinský. Dávejte pozor, komu nalejete. ","#","^cut","/#","\n",{"->":"0.g-1"},{"#f":5}]}],"g-1":["end",["done",{"#n":"g-2"}],null]}],"done",null],"listDefs":{}}